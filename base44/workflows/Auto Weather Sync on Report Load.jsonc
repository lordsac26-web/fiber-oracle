{
  "name": "Auto Weather Sync on Report Load",
  "description": "Automatically syncs daily high/low weather for all 61 service-area zip codes when a PON PM report finishes processing (status becomes completed). Idempotent \u2014 re-runs are cheap no-ops.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"processing_status\") != null) and (.trigger.data.processing_status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PONPMReport"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_weather_sync_on_report_load",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "autoSyncWeatherOnReport",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "autoSyncWeatherOnReport"
  }
}